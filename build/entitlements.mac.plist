<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron's V8 engine under hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The reason murmure exists: capture audio from the microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- v1.3.0 — optional video feed shown behind the subtitles on the
       audience display. Operator picks a camera in Setup; capture happens
       in both the operator preview and the audience renderer. -->
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
